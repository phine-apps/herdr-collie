{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 9-11 * * 1"
  ],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": [],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Group all non-major npm updates (migrated from Dependabot)",
      "matchManagers": ["npm"],
      "groupName": "npm-dependencies"
    },
    {
      "description": "Ignore @types/vscode to keep parity with engines.vscode",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/vscode"],
      "enabled": false
    },
    {
      "description": "Ignore major npm updates (migrated from Dependabot)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep pnpm on v10 major version",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group all github-actions updates (migrated from Dependabot)",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
